/target
**/*.rs.bk
*.pdb

# local dev databases
*.db
*.db-shm
*.db-wal

# machine-specific cargo config (sets DATABASE_URL to an absolute local dev DB path)
.cargo/config.toml

# vendored libsignal checkout (cloned per machine — see README; AGPL upstream, kept out of the repo)
/deps/libsignal

# package outputs copied to the repo root by the build scripts
/*.deb
/*.rpm
/*.flatpak

# flatpak-builder work dirs (build sandbox, cache, local ostree repo — huge)
/packaging/flatpak/.flatpak-builder/
/packaging/flatpak/build-dir/
/packaging/flatpak/repo/

# editor / tooling
.idea/
.vscode/
.claude/settings.local.json
# generated by cxx-qt-build 0.9 for the QML language server (machine-specific absolute buildDir)
**/.qmlls.ini
